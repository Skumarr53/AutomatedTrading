description: "Find the 10% that causes 90% of the slowdown"
globs: ["**/*performance*", "**/*optimize*", "**/*optimization*", "**/*benchmark*", "**/*profile*", "**/*profiling*", "**/*speed*", "**/*fast*", "**/*slow*", "**/*latency*", "**/*throughput*", "**/*efficiency*", "**/*efficient*", "**/*bottleneck*", "**/*scalability*", "**/*scale*", "**/*memory*", "**/*cpu*", "**/*resource*", "**/*measure*", "**/*metric*"]
