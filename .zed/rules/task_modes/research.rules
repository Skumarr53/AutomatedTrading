description: "Depth-first research with production pragmatism and strict learning enforcement"
globs: ["**/research/**", "**/*research*", "**/*investigate*", "**/*investigation*", "**/*analysis*", "**/*analyze*", "**/*compare*", "**/*comparison*", "**/*evaluate*", "**/*evaluation*", "**/*explore*", "**/*exploration*", "**/*study*", "**/*examine*", "**/*examination*", "**/*review*", "**/*survey*", "**/*assess*", "**/*assessment*"]
alwaysApply: false
priority: 85
