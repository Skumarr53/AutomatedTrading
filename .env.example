# .env.example
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# Fyers API Credentials
# =============================================================================
FYERS_CLIENT_ID=your_fyers_client_id
FYERS_SECRET_ID=your_fyers_secret_key
TOTP_SECRET=your_totp_secret
USER_PIN=your_user_pin
USER_NAME=your_username

# =============================================================================
# InfluxDB Configuration
# =============================================================================
# For local Podman deployment, use these defaults
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=trading_influxdb_token_change_in_prod
INFLUXDB_ORG=trading
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=trading_password_123
INFLUXDB_BUCKET=ticker_data

# =============================================================================
# MLflow Configuration
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000

# =============================================================================
# Ray Configuration (optional for distributed mode)
# =============================================================================
RAY_ADDRESS=auto
RAY_DASHBOARD_HOST=0.0.0.0
RAY_DASHBOARD_PORT=8265

# =============================================================================
# Telegram Notifications (optional)
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# Environment Settings
# =============================================================================
ENVIRONMENT=development
SUPPRESS_WARNINGS=1
VERBOSE_LOGGING=0
