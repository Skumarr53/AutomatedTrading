# Dockerfile.mlflow
# Python-based MLflow server (fallback option)
# Build with: podman build -f Dockerfile.mlflow -t trading-mlflow:local .

FROM docker.io/python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install MLflow
RUN pip install --no-cache-dir mlflow>=2.0.0

# Create directory and set permissions
# We use chmod 777 so that any user (root or non-root) can write to it
RUN mkdir -p /mlflow/artifacts && chmod -R 777 /mlflow

# Expose MLflow port
EXPOSE 5000